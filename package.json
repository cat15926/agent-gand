{
  "name": "agent-gand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-gand/server --filter @agent-gand/web dev",
    "dev:server": "pnpm --filter @agent-gand/server dev",
    "dev:web": "pnpm --filter @agent-gand/web dev",
    "typecheck": "pnpm -r typecheck",
    "verify:scheduler": "node scripts/verify-scheduler.mjs",
    "verify:agents": "node scripts/verify-agent-management.mjs",
    "verify:p0-tools": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-p0-toolchain.mjs",
    "verify:collaboration": "node scripts/verify-collaboration.mjs",
    "verify:collaboration-reliability": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-collaboration-reliability.mjs",
    "verify:collaboration-ui": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-collaboration-ui.mjs",
    "verify:chat-scroll": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-chat-scroll.mjs",
    "verify:observability": "node scripts/verify-observability.mjs",
    "verify:durable": "node scripts/verify-durable-execution.mjs",
    "verify:coordination": "node scripts/verify-coordination.mjs",
    "verify:coordination-planner": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-coordination-planner.mjs",
    "verify:followup-stage3": "node scripts/verify-followup-stage3.mjs",
    "verify:coordination-stage-e": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/verify-coordination-stage-e.mjs",
    "evaluate:coordination-planner": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/evaluate-coordination-planner.mjs",
    "verify:docs": "node scripts/verify-doc-links.mjs",
    "db:reset": "rm -f apps/server/data/*.sqlite*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

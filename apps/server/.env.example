# 服务端口（默认 3010）
PORT=3010

# SQLite 路径（默认 apps/server/data/agent-gand.sqlite）
# DB_PATH=

# agent 定义目录（默认 <repo>/agents）
# AGENTS_DIR=

LOG_LEVEL=info

# 外部 Code Agent（阶段 A：服务端本机 CLI，只读，macOS/Linux）
# 命令可以是 PATH 中的名称或绝对路径；不能包含参数。不读取 LLM_* 作为 CLI 认证。
# EXTERNAL_CLAUDE_COMMAND=claude
# EXTERNAL_CODEX_COMMAND=codex
# CLI 推理进程的超时毫秒；默认 180000，检测/策略检查另有短超时。
# EXTERNAL_AGENT_TIMEOUT_MS=180000

# 阶段 B：Claude Agent SDK 使用 API key；与内置 LLM_ANTHROPIC_API_KEY 分开配置。
# ANTHROPIC_API_KEY=
# Codex app-server 当前仅验证 0.159.2，使用独立、持久的执行目录，
# 不继承用户 MCP、免审规则或自定义模型 Provider；在同一 CODEX_HOME 下先完成 codex login。
# 默认 <DB_PATH 目录>/external/codex；不接受已有 config.toml/rules/skills/plugins。
# EXTERNAL_CODEX_HOME=/absolute/path/to/dedicated-codex-home
# 双向后端写入仅支持已注册的 Git 仓库根目录；CLI/SDK 安装检测不代表模型账户可用。

# 阶段 D：默认将注册 Git 仓库的 HEAD、未提交 diff 和未忽略的未跟踪文件
# 复制到独立 worktree，原仓库文件不接收 agent 变更；运行页下载补丁后人工检查/应用。
# isolated（默认）/ registered（兼容直接访问注册目录，不能获得 worktree/固定快照保证）
# EXTERNAL_WORKSPACE_MODE=isolated
# 默认 <DB_PATH 目录>/external/workspaces；只支持单宿主 macOS/Linux。
# EXTERNAL_WORKSPACE_DIR=/absolute/path/to/managed-workspaces
# Claude SDK 私有持久目录，默认 <DB_PATH 目录>/external/claude；不能指向用户 .claude，
# 不接受 settings/hooks/plugins/skills/agents 或登录凭证，仍只使用 ANTHROPIC_API_KEY。
# EXTERNAL_CLAUDE_HOME=/absolute/path/to/dedicated-claude-home
# sessionPolicy 在角色 execution 中配置 turn/run/conversation；旧角色缺省仍为 turn。
# 每个 SQLite 数据库只允许一个活动应用服务，旧服务存活时不能靠租约过期接管。

# ---- 真实 LLM（规格 §7.1；不配置则只能用 mock:* 模型）----

# OpenAI 兼容提供方（OpenAI / DeepSeek / GLM / Qwen 等）
LLM_OPENAI_API_KEY=
# 接兼容端点时改 BASE_URL，例如 DeepSeek：
# LLM_OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_OPENAI_BASE_URL=

# Anthropic
LLM_ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_BASE_URL=

# 可选出站代理（设置后 LLM 请求走该代理，如 http://127.0.0.1:7897；不设直连）
# LLM_PROXY=

# 单次响应 max_tokens，默认 8192。thinking 模型（如 GLM）思考也耗预算，
# 过小会出现"只思考不出正文"（stop_reason=max_tokens 且正文为空），此时调大此值
# LLM_MAX_TOKENS=8192

# 单次请求超时（毫秒），默认 180000。thinking 模型长生成可能超过 60s，超时会报
# "The operation was aborted due to timeout"，此时调大此值
# LLM_TIMEOUT_MS=180000

# 可选模型计价（美元/百万 token）。完整路由优先，也可用 provider:* 作为兜底。
# 未配置的模型成本显示为 0，不猜测供应商价格。
# LLM_PRICING_JSON={"openai:my-model":{"inputPerMillion":1,"outputPerMillion":4},"anthropic:*":{"inputPerMillion":2,"outputPerMillion":8}}

# Coordination 阶段 D：可选专用规划模型。不配置时复用所选团队中首个非 mock 的 coordinate Agent；
# 团队没有真实协调模型时安全回退到确定性规划。
# COORDINATION_PLANNER_MODEL=anthropic:claude-sonnet-4-5
# 模型候选未通过校验时最多修复次数、单次输出预算及低风险自动开始阈值。
# COORDINATION_PLANNER_MAX_ATTEMPTS=2
# COORDINATION_PLANNER_MAX_TOKENS=2048
# COORDINATION_AUTO_START_THRESHOLD=0.82
# 阶段 E 会根据用户选择替代方案、运行中调整计划产生的纠正样本保守校准该基线。
# 只读 Capability Registry MCP Server 可用：pnpm --filter @agent-gand/server coordination:mcp

# 审批等待超时（毫秒），默认 300000（5 分钟）；0 = 不超时。
# 超时后审批置 expired（decidedBy=system:timeout）并按拒绝处理该工具，不遗留 pending
# APPROVAL_TIMEOUT_MS=300000

# 同一 Agent 轮次内审批连续超时上限，默认 2；达到即中止轮次。
# Coordination run 会转入 waiting_for_user 暂停，等待用户在界面恢复或取消（AG-COORD-04）
# APPROVAL_MAX_EXPIRIES=2

# MCP stdio server（可选；未配置时 MCP client 返回空列表）
# MCP_SERVER_CMD=npx
# MCP_SERVER_ARGS=-y @modelcontextprotocol/server-filesystem /tmp
# MCP_HEARTBEAT_MS=30000
# Supervisor 调度（可选）
ORCHESTRATOR_CONCURRENCY=2
TASK_MAX_ATTEMPTS=3
TASK_LEASE_MS=300000
# Collaboration 动态调度
COLLAB_MAX_DEPTH=12
COLLAB_MAX_DISPATCHES=20
COLLAB_MAX_TARGETS=3
COLLAB_MAX_CONCURRENCY=3
COLLAB_MAX_ATTEMPTS=2
COLLAB_BATCH_TIMEOUT_MS=300000
COLLAB_RUN_TIMEOUT_MS=1800000
COLLAB_MAX_TOKENS=100000
COLLAB_MAX_COST_USD=5
COLLAB_MAX_BUDGET_MULTIPLIER=4
COLLAB_PINGPONG_WARN=2
COLLAB_PINGPONG_BLOCK=4
COLLAB_ATTEMPT_LEASE_MS=300000
COLLAB_EXIT_GUARD_MAX_CORRECTIONS=1
COLLAB_EXIT_GUARD_CORRECTION_MAX_TOKENS=2048
# 新 Collaboration Run 只允许 execute。旧 Profile 仅保留终态历史的只读解释。
# 执行策略会冻结到 Run Contract；退役配置会在启动时被拒绝。
# COLLAB_RUNTIME_MODE=execute

# Coordination Runtime Kernel：off / shadow（只记录对比）/ execute（默认，接管终局验收）。
# 模式会冻结到新 Run Contract；已有 Run 不会因重启或开关变化切换语义。
# COORDINATION_RUNTIME_KERNEL=execute
# execute 灰度协议，按 single/sequential → parallel → review → debate 逐步放量。
# COORDINATION_RUNTIME_PROTOCOLS=single_agent,sequential_pipeline,parallel_fanout,supervisor_aggregation,review_revision,debate
